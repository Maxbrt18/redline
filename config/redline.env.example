# Copy this file to /etc/redline/runtime/coach-messenger.env on the VPS (or to `.env`
# at the engine root, locally) and fill in the values.
# NEVER commit this file once filled in: in production it lives outside the repository
# (/etc/redline/runtime/coach-messenger.env); locally, `.env` at the root (ignored).
# Channel: Messenger (python3 -m redline).

# --- Messenger (Meta Messenger Platform) ---
# PAGE access token (ideally permanent, through a System User). See the README.
MESSENGER_PAGE_TOKEN=EAAG...token-de-page
# Free-form string YOU choose; copy it verbatim into the Meta webhook configuration.
# Do NOT keep this value: this file is in Git, so any example default is public.
# The service refuses to start below 32 characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MESSENGER_VERIFY_TOKEN=REMPLACE-MOI
# App secret (Meta > App settings > General): verifies webhook signatures.
MESSENGER_APP_SECRET=abcdef0123456789
# Mandatory lock: your PSID (page-scoped ID), taken from the Meta interface.
# The service refuses to start with an empty value.
MESSENGER_ALLOWED_PSID=1234567890
# Graph API version (keep the default unless there is a specific reason).
GRAPH_API_VERSION=v21.0
# Local port the HTTP service listens on. Must match the Caddyfile.
WEBHOOK_PORT=8000
# The address it listens on: 127.0.0.1 behind Caddy on the same host, 0.0.0.0 in the
# container of compose.yml.
# WEBHOOK_HOST=127.0.0.1

# --- Vault (the git clone on the VPS, owned by the service account) ---
VAULT_PATH=/var/lib/redline/vault
GIT_REMOTE=origin
GIT_BRANCH=main

# --- Canonical PostgreSQL storage ---
# Mandatory. The Markdown/CSV files are regenerable Obsidian views; neither Git nor
# state.json is a database.
DATABASE_URL=postgresql+psycopg://redline_app:CHANGE-ME@/redline?host=/run/redline-postgres

# --- Conversation engine: claude or codex (required) ---
AGENT_PROVIDER=claude

# Codex (install the `codex` extra): the SDK uses its pinned CLI runtime. Set CODEX_BIN only to deliberately test
# another binary. Authenticate the systemd user ONCE:
#   codex login                                      # ChatGPT subscription quota
#   printenv OPENAI_API_KEY | codex login --with-api-key  # pay-per-use API billing
# Check: codex login status
# CODEX_BIN=/explicit/path/to/codex

# Claude Code 2.1.296+ (`--restricted`). Generate the token with `claude setup-token` (Pro/Max subscription) and uncomment the two lines.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CLAUDE_BIN=claude

# Routing shared by both providers. Each route declares a primary profile and a
# preflight fallback, except triage which has none. Once a turn has started, watchdog,
# cancellation and in-flight failure are terminal: no second model redoes the work.
# Codex defaults: triage GPT-6 Luna Low, N0 Luna Medium, N1 Luna High, N2 GPT-6 Sol
# Medium, N3/deep/heavy proactive Sol High. Fallbacks are Luna Max.
# Claude defaults: triage Haiku 5.5 Low (pinned), N0/N1 Sonnet Low, N2 Sonnet High,
# N3 Opus Medium, deep/heavy proactive Opus High.
# To override a route without a release: REDLINE_ROUTING names a TOML file of
# `[routing.<ROUTE>]` tables (model, effort, fallback = { model, effort }). Routes:
# TRIAGE, N0, N1, N2, N3, DEEP, HEAVY. A fallback on TRIAGE is refused at startup: a
# slow triage is treated as N1. Efforts are checked for the provider: an unknown one
# stops the service at startup instead of failing mid-turn. Example:
# config/routing.example.toml.
# REDLINE_ROUTING=/etc/redline/routing.toml
# Watchdog for N0/N1 answers, in seconds.
AGENT_TIMEOUT=600
# Watchdog for real N2/N3 reasoning and for /deep. A waiting message is sent at 75 s;
# at 90 s the typing indicator stops without interrupting the handle;
# /status and /cancel stay active.
AGENT_TIMEOUT_DEEP=1800
# Maximum duration of a deep review: it reads the whole ledger, computes, writes the
# journal and renders an image. A run killed midway has spent the quota and sends
# nothing.
AGENT_TIMEOUT_HEAVY=5400

# --- Reading-depth triage ---
# Every incoming message is classified N0-N3 (reading ladder of CLAUDE.md) by a small
# model: the level decides what the coach READS, how long it may take (N2/N3 announce
# the wait immediately) and which profile answers.
# Light profile (Luna Low / Haiku 5.5 Low), no shell or project documentation, and no
# fallback: on failure or timeout, the message is handled as N1.
# TRIAGE_ENABLED=true
# TRIAGE_TIMEOUT=10

# --- Natural conversation ---
# Sessions, delivery debts, quotas and proactive tasks live in PostgreSQL.
# Lifetime of an agent session: beyond it, the next message starts from a fresh vault
# context.
SESSION_TTL_HOURS=6
# Debounce: texts sent in a burst are grouped into a single agent turn.
# Wait DEBOUNCE_SECONDS after the last text (restarted on each new one),
# capped at DEBOUNCE_MAX_SECONDS since the first.
DEBOUNCE_SECONDS=5
DEBOUNCE_MAX_SECONDS=20

# --- Proactivity (the coach takes the initiative) ---
# Master switch. Only active if MESSENGER_ALLOWED_PSID is set.
PROACTIVE_ENABLED=true
# Start of the window in which the coach may write spontaneously; it runs until
# midnight. PROACTIVE_ACTIVE_END does not exist and is not read.
PROACTIVE_ACTIVE_START=07:30
# No daily cap: each relevant initiative keeps its own expiry window. The interval
# below only spaces out ordinary initiatives; 0 lets them go as soon as they are due.
PROACTIVE_MIN_GAP_HOURS=4
# Training silence: days without activity or message before checking in.
PROACTIVE_SILENCE_DAYS=3
# Morning message (local time; empty = disabled). The agent decides what to say, or
# stays silent (typed answer send=false).
PROACTIVE_MORNING=07:45
# Weekly review on Sunday evening (local time; empty = disabled).
PROACTIVE_WEEKLY=19:00
# Monthly magazine, on the 1st of the month (local time; empty = disabled).
PROACTIVE_MONTHLY=18:30
# Maximum delay before an activity debrief: it goes out earlier as soon as the athlete
# renames the activity, gives their feedback in the logbook or writes to the coach.
STRAVA_DEBRIEF_DELAY=300
# Free-form string YOU choose to validate the Strava webhook subscription (see README).
# Same rule: this file is public, this value must never be the real one.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STRAVA_VERIFY_TOKEN=REMPLACE-MOI
# Strava does not sign its events and your athlete id is public: the route is
# authenticated only by this secret segment of the callback URL
# (<COACH_BASE_URL>/strava-webhook/<STRAVA_WEBHOOK_SECRET>). Empty = route disabled;
# 32 characters minimum, same command as above. Changing it requires recreating the
# Strava subscription (README, Strava subscription section).
STRAVA_WEBHOOK_SECRET=
# Your Strava athlete id (the number in your profile URL): only its events trigger a
# debrief.
STRAVA_OWNER_ID=

# --- Strava reading (redline strava) ---
# The SOURCE OF TRUTH for activities: without it, the coach receives the webhook event
# and has nothing to say about it. The values live here because systemd loads this file
# and the SDK copies the whole environment into the sandbox -- the same path as
# DATABASE_URL, valid for ALL engines.
#
# THIS FILE CARRIES ONLY THE APPLICATION IDENTITY, never a token. Tokens live in
# $REDLINE_STATE_DIR/strava-token.json, the single owner, because they ROTATE: a seed
# copied here silently becomes stale at the first rotation.
# Created at https://www.strava.com/settings/api (scope `activity:read_all`).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
#
# Bootstrap, once, ON THE COACH MACHINE and in an interactive terminal:
#   redline strava login    # reads the code on stdin, never as an argument
# Check at any time:
#   redline strava check

# --- Monitoring (optional but recommended) ---
# healthchecks.io ping URL (free): the service pings it every 5 min; if the pings stop
# (service dead, VPS down), you receive an email. Empty = off.
HEALTHCHECK_PING_URL=

# --- Interactive strength session (page + signed report) ---
# Public origin of the service (the one in the Caddyfile). The script attaches the
# snapshot to the card; after the image is delivered, the service stores it and mints
# an opaque token. Empty = no snapshot and no button, the card goes out alone.
COACH_BASE_URL=https://coach.example.com
# Cap on reports accepted per day: bounds the number of agent turns a public route can
# trigger. At two sessions a week, 8 leaves all the margin needed.
STRENGTH_REPORTS_PER_DAY=8

# Messenger attachments: private raw copy, bounded and deleted after each analysis.
# Default: $REDLINE_STATE_DIR/attachments.
#ATTACHMENT_DIR=/var/lib/redline/state/attachments
ATTACHMENT_MAX_BYTES=12582912
ATTACHMENT_TOTAL_BYTES=20971520

# --- Cards (PNG) ---
# Path of a system Chromium, if no Playwright download exists for the platform (the
# Oracle/Ampere VPS is arm64). Empty = Playwright's Chromium.
# CHROMIUM_PATH=/usr/bin/chromium

# What the service writes outside PostgreSQL: card outbox, attachments being read,
# Strava token cache. Default: var/ in the engine checkout; the reference unit sets
# it to /var/lib/redline/state, the one tree the service may write with the vault.
#REDLINE_STATE_DIR=/var/lib/redline/state
