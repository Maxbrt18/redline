# The variables compose.yml reads, copied to `.env` at the checkout root (never
# committed). The service's own configuration is `redline.env`, from
# config/redline.env.example, with DATABASE_URL set to:
#   postgresql+psycopg://redline_app:<postgres_app_password>@postgres:5432/redline

# The domain Caddy serves, resolving to this host.
REDLINE_DOMAIN=coach.example.com
# The migrator role, which owns the schema.
MIGRATOR_DATABASE_URL=postgresql+psycopg://redline_migrator:CHANGE-ME@postgres:5432/redline
