# For deploy/postgres/compose.yml and backup.sh: copy it out of Git, for instance to
# /etc/redline/postgres.env.
REDLINE_SECRETS_DIR=/etc/redline/secrets
REDLINE_BACKUP_DIR=/var/lib/redline-backups
REDLINE_AGE_RECIPIENT_FILE=/etc/redline/secrets/backup-age-recipient.txt
REDLINE_BACKUP_RETENTION_DAYS=3
