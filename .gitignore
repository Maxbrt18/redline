.DS_Store
# État d'UI Obsidian par appareil (panneaux ouverts, zoom du graphe) : pur bruit.
# La vraie config (app/appearance/core-plugins) reste suivie.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Fichiers d'échange / temporaires d'éditeur — un .env.swp contient le .env en
# clair (tokens). Le bot fait `git add -A` : sans ça il pousserait le swap.
*.sw[a-p]
.*.sw[a-p]
*~
.*.swp
*.swo
.env
.env.*
!.env.example

# Python bytecode (le bot VPS fait git add -A : sans ça il pousse les .pyc)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/


# Instructions locales injectées par Codex Desktop ; le serveur suit CLAUDE.md.
AGENTS.md

# JSON qu'un tour du coach remet à une CLI (`--input`), un fichier par tour, supprimé
# en fin de tour : scripts/model/agent_input.py. Le service fait `git add -A`.
.agent-tmp/

# Your own coaching data lives in a PRIVATE vault, never in this repository.
/athlete/
/inbox/
/episodes/
/concepts/
/sources/
server/attachments/
