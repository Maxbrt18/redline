# Caddy -- automatic HTTPS (Let's Encrypt) for the Messenger webhook.
# The domain coach.example.com must resolve to the VPS IP through an A record in
# Cloudflare set to "DNS only" (grey cloud, not orange): otherwise Cloudflare
# terminates TLS and Caddy cannot obtain its certificate.
# Caddy obtains and renews the certificate by itself as long as ports 80 and 443 are
# open and the domain points here.
#
#   sudo cp ~/redline/deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl restart caddy
#   sudo systemctl status caddy

coach.example.com {
	# Email for Let's Encrypt expiry notices (optional but recommended).
	tls admin@example.com

	# No legitimate body comes near 1 MB; the service enforces the same cap.
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		-Via
	}

	# /ready queries PostgreSQL on every call: reserved for the host, through
	# 127.0.0.1:8000.
	# /health stays public: in-memory answer, no database.
	respond /ready 404

	# The HTTP service listens locally; Caddy terminates TLS and proxies.
	reverse_proxy 127.0.0.1:8000
}
