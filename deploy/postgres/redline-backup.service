[Unit]
Description=Export PostgreSQL Redline chiffré pour collecte hors VPS
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
SupplementaryGroups=docker
UMask=0077
StateDirectory=redline-backups
StateDirectoryMode=0700
Environment=REDLINE_POSTGRES_ENV=/etc/redline/postgres.env
EnvironmentFile=/etc/redline/postgres.env
ExecStart=/home/ubuntu/redline/deploy/postgres/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/redline-backups
RestrictSUIDSGID=true
LockPersonality=true
