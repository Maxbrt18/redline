[Unit]
Description=Redline coach (Codex or Claude Code on the vault, Messenger webhook)
After=network-online.target
Wants=network-online.target
# Bound crash loops. Deployment is external; Restart=always only recovers runtime
# failures and does not update the checkout.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
# `systemctl restart` must not report success before the HTTP readiness contract is true.
TimeoutStartSec=150s
# --- Adapt these 4 lines to your VPS ---
User=ubuntu
WorkingDirectory=/home/ubuntu/redline
EnvironmentFile=/etc/redline/runtime/coach-messenger.env
# PATH must contain `node` and, when selected, `claude`. The nightly updater
# (agent-runtime-update.py) owns both runtimes: the Codex SDK ships its runtime
# from the active venv, and `claude` comes from ~/.claude-runtimes/current, ahead
# of the global npm install that only serves as the bootstrap fallback. The venv comes
# FIRST on purpose: card scripts are run through bash
# as `python3 scripts/chart-*.py`, so the `python3` resolved here is the one that
# has to import playwright. Point it at the system python and the coach silently
# stops attaching images. The venv lives OUTSIDE the repo -- the bot does
# `git add -A`, and a venv inside the working tree would get committed.
Environment=PATH=/home/ubuntu/.venvs/redline-current/bin:/home/ubuntu/.claude-runtimes/current/node_modules/.bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# Claude Code must not update itself: only the nightly updater promotes a version,
# after a real preflight. Its own updater failed silently from 2.1.197 onwards.
Environment=DISABLE_AUTOUPDATER=1
Environment=PYTHONPATH=/home/ubuntu/redline:/home/ubuntu/redline/server
# Timezone: the schedule (debrief, morning note, usage-limit reset, commit stamps)
# must be on Sam's local time, not UTC.
Environment=TZ=Europe/Paris

ExecStartPre=/usr/bin/test -S /run/redline-postgres/.s.PGSQL.5432
ExecStartPre=/usr/bin/test -x /usr/local/bin/redline-agent-cli
ExecStartPre=/usr/bin/test -r /usr/local/share/redline/agent-cli-tools.txt
ExecStart=/home/ubuntu/.venvs/redline-current/bin/python -m redline
ExecStartPost=/home/ubuntu/redline/server/wait-ready.sh 90
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
