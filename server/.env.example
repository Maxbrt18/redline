# Copie ce fichier en `.env` sur le VPS et remplis les valeurs.
# NE JAMAIS committer le .env (il est dans server/.gitignore).
# Canal : Messenger (python3 -m redline).

# --- Messenger (Messenger Platform Meta) ---
# Token d'accès de la PAGE (idéalement permanent via System User). Cf. README.
MESSENGER_PAGE_TOKEN=EAAG...token-de-page
# Chaîne libre que TU choisis ; à recopier à l'identique dans la conf webhook Meta.
# ⚠ NE GARDE PAS cette valeur : ce fichier est dans Git, donc tout défaut d'exemple est
# public. Le 2026-08-14 le .env de prod portait encore l'exemple mot pour mot.
# Le service refuse de démarrer sous 32 caractères.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MESSENGER_VERIFY_TOKEN=REMPLACE-MOI
# App secret (Meta > Paramètres app > Général) : vérifie la signature des webhooks.
MESSENGER_APP_SECRET=abcdef0123456789
# Verrou obligatoire : ton PSID (page-scoped ID), récupéré depuis l'interface Meta.
# Le service refuse de démarrer avec une valeur vide.
MESSENGER_ALLOWED_PSID=1234567890
# Version de l'API Graph (laisse le défaut sauf raison précise).
GRAPH_API_VERSION=v21.0
# Port local sur lequel le service HTTP écoute. Doit correspondre au Caddyfile.
WEBHOOK_PORT=8000

# --- Vault (le clone git sur le VPS) ---
VAULT_PATH=/home/ubuntu/redline
GIT_REMOTE=origin
GIT_BRANCH=main

# --- Stockage canonique PostgreSQL ---
# Obligatoire après la bascule. Les fichiers Markdown/CSV deviennent des vues
# Obsidian régénérables ; ni Git ni state.json ne sont alors une base de données.
DATABASE_URL=postgresql+psycopg://redline_app:CHANGE-ME@/redline?host=/run/redline-postgres

# --- Moteur de conversation : codex ou claude ---
# Codex utilise GPT-6 Luna/Sol par défaut. Claude reste disponible uniquement si le
# fournisseur est explicitement remplacé.
AGENT_PROVIDER=codex

# Codex : le SDK utilise son runtime CLI épinglé. Ne renseigne CODEX_BIN que pour
# tester volontairement un autre binaire. Authentifie UNE FOIS l'utilisateur systemd :
#   codex login                                      # quota de l'abonnement ChatGPT
#   printenv OPENAI_API_KEY | codex login --with-api-key  # facturation API à l'usage
# Vérification : codex login status
# CODEX_BIN=/chemin/explicite/vers/codex

# Claude Code 2.1.197+ : utile si AGENT_PROVIDER=claude. Génère le token avec
# `claude setup-token` (abonnement Pro/Max) et décommente les deux lignes.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CLAUDE_BIN=claude

# Routage commun aux deux fournisseurs. Chaque route déclare un profil principal et
# un repli de prévol, sauf le triage qui n'en a aucun. Dès qu'un tour a commencé, watchdog, annulation et panne en vol
# sont terminaux : aucun second modèle ne recommence le travail.
# Défauts Codex : triage GPT-6 Luna Low, N0 Luna Medium, N1 Luna High, N2 GPT-6 Sol
# Medium, N3/deep/proactif lourd Sol High. Les replis sont Luna Max.
# Défauts Claude : triage Haiku 5.5 Low (épinglé), N0/N1 Sonnet Low, N2 Sonnet High,
# N3 Opus Medium, deep/proactif lourd Opus High.
# Pour surcharger une route : AGENT_<ROUTE>_MODEL, _EFFORT et, facultativement,
# _FALLBACK_MODEL, _FALLBACK_EFFORT. Routes : TRIAGE, N0, N1, N2, N3, DEEP, HEAVY.
# AGENT_TRIAGE_FALLBACK_* est refusé au démarrage : un triage lent vaut N1.
# Les efforts sont validés pour le fournisseur et les modèles Codex connus : une
# combinaison non supportée arrête le service au démarrage au lieu d'échouer en tour.
# Exemples Codex :
# AGENT_N1_MODEL=gpt-6-luna
# AGENT_N1_EFFORT=high
# AGENT_N1_FALLBACK_MODEL=gpt-6-luna
# AGENT_N1_FALLBACK_EFFORT=high
# AGENT_N3_MODEL=gpt-6-sol
# AGENT_N3_EFFORT=high
# AGENT_DEEP_MODEL=gpt-6-sol
# AGENT_DEEP_EFFORT=high
# Watchdog des réponses N0/N1, en secondes.
AGENT_TIMEOUT=600
# Watchdog des vrais raisonnements N2/N3 et d'un /deep. Une phrase d'attente part à
# 75 s ; à 90 s l'indicateur de saisie s'arrête sans interrompre le handle ;
# /status et /cancel restent actifs.
AGENT_TIMEOUT_DEEP=1800
# Délai max d'un bilan profond : il lit tout le registre, calcule, écrit le journal
# et rend une image. Un run tué à mi-course a payé le quota et n'envoie rien.
AGENT_TIMEOUT_HEAVY=5400

# --- Triage de profondeur de lecture ---
# Chaque message reçu est classé N0-N3 (échelle de lecture du CLAUDE.md) par un petit
# modèle : le niveau décide ce que le coach LIT, combien de temps il a le droit de
# prendre (N2/N3 annoncent l'attente tout de suite) et quel profil répond.
# Profil léger (Luna Low / Haiku 5.5 Low), sans shell ni documentation projet, et sans
# repli : en cas d'échec ou de dépassement, le message est traité en N1.
# TRIAGE_ENABLED=true
# TRIAGE_TIMEOUT=10

# --- Conversation naturelle ---
# Sessions, dettes de livraison, quotas et tâches proactives sont dans PostgreSQL.
# Durée de vie d'une session agent : au-delà, le prochain message repart d'un
# contexte frais du vault (comme un coach qui rouvre le dossier le matin).
SESSION_TTL_HOURS=6
# Debounce : on regroupe les textos envoyés en rafale en un seul tour agent.
# On attend DEBOUNCE_SECONDS après le dernier texto (relancé à chaque nouveau),
# avec un plafond DEBOUNCE_MAX_SECONDS depuis le premier.
DEBOUNCE_SECONDS=5
DEBOUNCE_MAX_SECONDS=20

# --- Proactivité (le coach prend l'initiative comme un humain) ---
# Master switch. Ne s'active que si MESSENGER_ALLOWED_PSID est renseigné.
PROACTIVE_ENABLED=true
# Début de la fenêtre où le coach s'autorise à écrire spontanément ; elle court
# jusqu'à minuit. PROACTIVE_ACTIVE_END n'existe plus et n'est plus lu.
PROACTIVE_ACTIVE_START=07:30
# Aucun plafond journalier : chaque initiative pertinente conserve sa propre fenêtre
# d'expiration. L'intervalle ci-dessous espace seulement les initiatives ordinaires ;
# 0 les laisse partir dès qu'elles sont dues.
PROACTIVE_MIN_GAP_HOURS=4
# Silence sportif : nb de jours sans activité ni message avant de prendre des nouvelles.
PROACTIVE_SILENCE_DAYS=3
# Mot du matin (heure locale ; vide = désactivé). L'agent décide quoi dire, ou se tait
# (réponse typée send=false).
PROACTIVE_MORNING=07:45
# Bilan hebdo le dimanche soir (heure locale ; vide = désactivé).
PROACTIVE_WEEKLY=19:00
# Magazine du mois, le 1er du mois (heure locale ; vide = désactivé).
PROACTIVE_MONTHLY=18:30
# Délai maximal avant le débrief d'une sortie : il part plus tôt dès que l'athlète renomme
# la sortie, donne ses ressentis dans le carnet ou écrit au coach.
STRAVA_DEBRIEF_DELAY=300
# Chaîne libre que TU choisis pour valider l'abonnement au webhook Strava (cf. README).
# ⚠ Même règle : ce fichier est public, cette valeur ne doit jamais être la vraie.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STRAVA_VERIFY_TOKEN=REMPLACE-MOI
# Strava ne signe pas ses events et ton id d'athlète est public : la route n'est
# authentifiée que par ce segment secret de l'URL de callback
# (<COACH_BASE_URL>/strava-webhook/<STRAVA_WEBHOOK_SECRET>). Vide = route désactivée ;
# 32 caractères minimum, même commande que ci-dessus. Le changer impose de recréer
# l'abonnement Strava (README § Abonnement Strava).
STRAVA_WEBHOOK_SECRET=
# Ton id d'athlète Strava (le nombre dans l'URL de ton profil) : seuls ses events
# déclenchent un débrief.
STRAVA_OWNER_ID=

# --- Lecture Strava (scripts/strava.py) ---
# La SOURCE DE VÉRITÉ des activités : sans ça, le coach reçoit l'événement du webhook
# et n'a rien à en dire. Le 2026-08-14 ces valeurs ne vivaient que dans ~/.claude.json,
# donc pour le moteur Claude seulement : passé sous Codex, le coach a perdu Strava sans
# que rien ne le signale. Elles sont ici parce que systemd charge ce fichier et que le
# SDK recopie tout l'environnement dans le sandbox — le même chemin que DATABASE_URL,
# valable pour TOUS les moteurs.
#
# ⚠ CE FICHIER NE PORTE QUE L'IDENTITÉ DE L'APPLICATION, jamais un jeton. Les jetons
# vivent dans server/.strava-token.json, seul propriétaire, parce qu'ils TOURNENT :
# une amorce recopiée ici devient fausse à la première rotation, en silence.
# Créés sur https://www.strava.com/settings/api (scope `activity:read_all`).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
#
# Amorçage, une seule fois, SUR LA MACHINE DU COACH et dans un terminal interactif :
#   python3 scripts/strava.py login    # lit le code sur stdin, jamais en argument
# Vérification à tout moment :
#   python3 scripts/strava.py check

# --- Monitoring (optionnel mais recommandé) ---
# URL de ping healthchecks.io (gratuit) : le service la pingue toutes les 5 min ;
# si les pings s'arrêtent (service mort, VPS down), tu reçois un email. Vide = off.
HEALTHCHECK_PING_URL=

# --- Séance de renfo interactive (page + retour signé) ---
# Origine publique du service (celle du Caddyfile). Le script joint le snapshot à la
# carte ; après livraison de l'image, le service le stocke et frappe un jeton opaque.
# Vide = pas de snapshot ni de bouton, la carte part seule.
COACH_BASE_URL=https://coach.example.com
# Plafond de comptes-rendus acceptés par jour : borne le nombre de tours agent qu'une
# route publique peut déclencher. Deux séances par semaine, 8 laisse toute la marge utile.
STRENGTH_REPORTS_PER_DAY=8

# Pièces jointes Messenger : brut privé, borné et supprimé après chaque analyse.
ATTACHMENT_DIR=/home/ubuntu/redline/server/attachments
ATTACHMENT_MAX_BYTES=12582912
ATTACHMENT_TOTAL_BYTES=20971520

# --- Cartes (PNG) ---
# Chemin d'un Chromium système, si le téléchargement Playwright n'existe pas pour
# la plateforme (le VPS Oracle/Ampere est en arm64). Vide = Chromium de Playwright.
# CHROMIUM_PATH=/usr/bin/chromium
