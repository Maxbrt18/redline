#!/usr/bin/env bash
# Build the app in Release, signed with the team of Config/Local.xcconfig, and install it
# on a paired iPhone, over a cable or Wi-Fi. The device is a name or an identifier shown
# by `xcrun devicectl list devices`.
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: $0 <device name or identifier>" >&2
    exit 64
fi
device=$1
ios_dir=$(cd "$(dirname "$0")/.." && pwd)
build_dir="$ios_dir/.build/device"

if [[ ! -f "$ios_dir/Config/Local.xcconfig" ]]; then
    echo "Config/Local.xcconfig is missing: copy Config/Local.example.xcconfig and fill it in." >&2
    exit 78
fi

xcodebuild -project "$ios_dir/Redline.xcodeproj" -scheme Redline -configuration Release \
    -destination generic/platform=iOS -derivedDataPath "$build_dir" \
    -allowProvisioningUpdates -quiet build
xcrun devicectl device install app --device "$device" \
    "$build_dir/Build/Products/Release-iphoneos/Redline.app"
